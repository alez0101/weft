# Weft settings. Make your real .env with:  python3 -I tools/make_env.py --admin you@example.org
# (it fills in the secrets below with random values). Then add any optional settings you want.

# ---------- secrets (made by tools/make_env.py; never commit them) ----------
OWNER_PASSWORD=
AUTHENTICATOR_PASSWORD=
AUTH_SVC_PASSWORD=
NOTIFY_SVC_PASSWORD=
ASSIST_SVC_PASSWORD=
COLLAB_SVC_PASSWORD=
FILES_SVC_PASSWORD=
MCP_SVC_PASSWORD=
JWT_SECRET=
ASSIST_MASTER_KEY=            # 64 hex characters; encrypts model API keys. Losing it loses the saved keys.

# ---------- the first admin ----------
BOOTSTRAP_ADMIN_EMAIL=        # this email is made admin when it signs in

# ---------- network (optional) ----------
# WEFT_BIND=127.0.0.1         # 0.0.0.0 to reach Weft from other machines (put HTTPS in front of it)
# WEFT_PORT=3010
# WEFT_PROJECT=weft-core      # the compose project name; change it to run a second Weft on one machine
# WEFT_TEST_PORT=3011 WEFT_DB_PORT=55434 WEFT_API_PORT=3100   # the 127.0.0.1-only ports, if those are taken
# COOKIE_SECURE=true          # false only if people reach Weft over plain http on a LAN address

# ---------- sign-in (optional) ----------
# AUTH_METHODS=password       # password (Weft accounts), cloudflare (Cloudflare Access), or password,cloudflare
# ACCESS_TEAM_DOMAIN=         # for cloudflare: yourteam.cloudflareaccess.com
# ACCESS_AUD=                 # for cloudflare: the Access application's AUD tag
# SESSION_DAYS=30             # how long a signed-in browser stays signed in without using Weft

# ---------- files (optional) ----------
# FILE_MAX_MB=25              # largest file people can upload; files are stored in the database

# ---------- meaning search (optional) ----------
# EMBED_URL=                  # an Ollama server with nomic-embed-text, e.g. http://ollama-host:11434

# ---------- connector for AI apps (optional) ----------
# Claude and other MCP apps connect at <your address>/mcp and sign in with a Weft account.
# WEFT_PUBLIC_URL=            # the address people use, e.g. https://weft.example.org (needed behind a proxy or tunnel)
# MCP_REDIRECT_HOSTS=claude.ai,claude.com   # apps that may receive approvals (loopback addresses always may)
